# Backend environment variables
#
# Do not commit real secrets.

PORT=8080

# Gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-pro

# Google Sheets
SPREADSHEET_ID=YOUR_SPREADSHEET_ID
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=YOUR_SERVICE_ACCOUNT_JSON_B64

# If you want to override sheet tab names:
SHEETS_TAB_CONFIG=config

